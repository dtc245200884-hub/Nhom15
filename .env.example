# Du lieu SQLite mac dinh se duoc tao trong thu muc du an.
DATABASE_URL=sqlite:///./canteen_ai.db
# run.ps1 se tu tao SECRET_KEY ngau nhien khi tao .env lan dau.
SECRET_KEY=replace-me
ACCESS_TOKEN_EXPIRE_DAYS=30
# De trong neu chua cau hinh AI; cac chuc nang co the dung che do du phong.
GEMINI_API_KEY=
AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
